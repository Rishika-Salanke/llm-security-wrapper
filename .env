# The URL of the actual LLM you want to protect (Ollama, OpenAI, etc.)
BASE_LLM_URL="http://localhost:11434/v1/chat/completions"
MODEL_NAME="dolphin3:8b"

# Your Secret System Instructions
SYSTEM_PROMPT="You are a helpful, professional, and harmless AI assistant. Stick to facts."

# Security Sensitivity Threshold (0 to 1, where 1 is most sensitive)
SEMANTIC_THRESHOLD=0.5

# Where to save the logs
LOG_FILE_PATH="logs/security_audit.log"

# Set to 'True' to save logs to a file, 'False' to only show them in terminal
ENABLE_FILE_LOGGING=True